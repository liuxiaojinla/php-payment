{
	"name":"xin/payment",
	"description":"统一化微信支付、支付宝支付API",
	"type":"library",
	"authors":[
		{
			"name":"晋",
			"email":"657306123@qq.com"
		}
	],
	"license":"Apache-2.0",
	"minimum-stability":"stable",
	"require":{
		"php": ">=7.1.9",
		"xin/support": "^1.0",
		"xin/capsule": "^1.0",
		"yansongda/pay": "^3.5"
	},
	"require-dev":{
	},
	"suggest":{
		"yansongda/pay":"支付宝与微信支付的轮子"
	},
	"autoload":{
		"psr-4":{
			"Xin\\Payment\\":"src/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Xin\\Payment\\Laravel\\PaymentServiceProvider"
			]
		},
		"think": {
			"services": [
				"Xin\\Payment\\ThinkPHP\\PaymentServiceProvider"
			],
			"config": {
				"payment": "config/config.php"
			}
		}
	}
}
